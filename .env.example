# Copia este archivo a .env SOLO para pruebas locales (npm start no lo lee solo;
# exporta las variables o usa: node --env-file=.env server.js  en Node 20+)
ANTHROPIC_API_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
SOLICITANTE_USER=solicitante
SOLICITANTE_PASSWORD=cambia-esta-clave-2
SESSION_SECRET=una-cadena-larga-y-aleatoria
# Carpeta donde se guardan los datos. En Render con disco persistente: /var/data
DATA_DIR=./data-runtime
